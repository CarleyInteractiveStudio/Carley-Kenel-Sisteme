import "project-K/lib/hardware/screen.dk"
import "project-K/lib/ui/window.dk"

# Engine de Interfaz Gráfica y Escritorio Básico para COS / CK Kernel

fnc gui_draw_desktop() {
    # 1. Fondo del Escritorio (Azul Cian: attr 63)
    screen_fill_color(63)

    # 2. Barra de Menú Superior estilo macOS (Fila 0, Columnas 0..79)
    col = 0
    while (col < 80) {
        screen_write_char(col, 0, 32, 112) # Barra Gris
        col = col + 1
    }

    # Logo e Menús
    screen_write_char(1, 0, 240, 112) # Logo OS
    screen_write_char(3, 0, 67, 112)  # C
    screen_write_char(4, 0, 79, 112)  # O
    screen_write_char(5, 0, 83, 112)  # S

    # Opciones de Menú: Archivo, Edición, Ver
    screen_write_char(10, 0, 65, 112) # A
    screen_write_char(11, 0, 114, 112) # r
    screen_write_char(12, 0, 99, 112)  # c
    screen_write_char(13, 0, 104, 112) # h

    # Reloj / Versión del Sistema a la derecha
    screen_write_char(73, 0, 67, 112) # C
    screen_write_char(74, 0, 75, 112) # K
    screen_write_char(75, 0, 32, 112) #
    screen_write_char(76, 0, 118, 112) # v
    screen_write_char(77, 0, 49, 112) # 1
    screen_write_char(78, 0, 46, 112) # .
    screen_write_char(79, 0, 48, 112) # 0

    # 3. Ventana Principal de Aplicación
    ui_draw_window(10, 3, 60, 16, 31, 112, 120)

    # Texto de Bienvenida dentro de la ventana
    screen_write_char(22, 4, 67, 31)  # C
    screen_write_char(23, 4, 97, 31)  # a
    screen_write_char(24, 4, 114, 31) # r
    screen_write_char(25, 4, 108, 31) # l
    screen_write_char(26, 4, 101, 31) # e
    screen_write_char(27, 4, 121, 31) # y
    screen_write_char(28, 4, 32, 31)  #
    screen_write_char(29, 4, 79, 31)  # O
    screen_write_char(30, 4, 83, 31)  # S

    # 4. Dock Inferior estilo macOS (Filas 22..24, Cols 20..60)
    d = 20
    while (d < 60) {
        screen_write_char(d, 22, 32, 120)
        screen_write_char(d, 23, 32, 120)
        d = d + 1
    }

    # Iconos de Aplicaciones en el Dock
    screen_write_char(24, 23, 254, 113) # Archivos
    screen_write_char(34, 23, 227, 114) # Terminal
    screen_write_char(44, 23, 15, 115)  # Ajustes
    screen_write_char(54, 23, 14, 116)  # Música
}
